{
 "about": "The oracle rows (tools/oracle.py): each runs on trash-cli and on this repository's tools in matching scratch homes. Paths in make steps are relative to the home, or @xdev/ for the second file system; \\\\xHH in a path or an argument is one byte.",
 "rows": [
  {
   "name": "put-file",
   "about": "a plain file from the home",
   "steps": [
    {
     "make": [
      [
       "file",
       "a.txt",
       "hello\n"
      ]
     ]
    },
    {
     "run": [
      "trash",
      "a.txt"
     ]
    }
   ]
  },
  {
   "name": "put-file-absolute",
   "about": "the same file named by its absolute path",
   "steps": [
    {
     "make": [
      [
       "file",
       "a.txt",
       "hello\n"
      ]
     ]
    },
    {
     "run": [
      "trash",
      "/tmp/trash-rows/home/a.txt"
     ]
    }
   ]
  },
  {

{
 "about": "The stress rows (tools/harden.py stress): a fixture, then two commands (`pair`) at once, N rounds from a seed; each round draws which starts first, a start gap and a pause (TRASH_PAUSE) at one of `pause.steps` for one of them, and the result is held to the outcomes its `allowed` kind admits.",
 "rows": [
  {
   "name": "race-collide",
   "about": "two trash runs of two files named a.txt at once",
   "steps": [
    {
     "make": [
      [
       "file",
       "d1/a.txt",
       "one\n"
      ],
      [
       "file",
       "d2/a.txt",
       "two\n"
      ]
     ]
    }
   ],
   "pair": [
    {
     "run": [
      "trash",
      "d1/a.txt"
     ]
    },
    {
     "run": [
      "trash",
      "d2/a.txt"
     ]
    }
   ],
   "pause": {
    "steps": [
     1,
     8
    ],
    "ms": [
     5,
     20,
     50
    ]
   },
   "allowed": "collide",
   "contents": [
    "one\n",
    "two\n"
   ]
  },
  {
   "name": "race-put-empty",

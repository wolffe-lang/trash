{
 "about": "PAX's rows (tools/pax-rows.py): each runs on PAX under KVM, the home on PAX's ext2 home disk (/home/rh) and the second store PAX's in-memory /tmp (@tmp/ is /tmp/rows). Paths in make steps are relative to the home; 'name' makes an empty file whose name is the given hex bytes (the C fixture); an 'exec' step runs trash with its last argument as bytes. The companions run as trash does, each command with its standard input from the row.",
 "rows": [
  {
   "name": "pax-put-file",
   "about": "a plain file on the ext2 home",
   "steps": [
    {
     "make": [
      [
       "file",
       "a.txt",
       "hello\n"
      ]
     ]
    },
    {
     "run": [
      "trash",
      "a.txt"
     ]
    }
   ]
  },
  {
   "name": "pax-put-dir",
   "about": "a directory tree on the ext2 home, moved whole",
   "steps": [
    {
     "make": [
      [
       "dir",
       "d"
      ],
      [
       "file",
       "d/f",
       "f\n"
      ],
      [
       "dir",
       "d/sub"
      ],
      [
       "file",
       "d/sub/g",
       "g\n"
      ],
      [
       "link",
       "f",
       "d/lf"
      ]
     ]
    },
    {
     "run": [
      "trash",
      "d"
     ]
    }
   ]
  },
  {
   "name": "pax-put-links",

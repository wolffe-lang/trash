       "0500"
      ],
      [
       "file",
       "@tmp/d/sub/ro/g",
       "g\n",
       "0444"
      ],
      [
       "link",
       "../f",
       "@tmp/d/sub/up"
      ],
      [
       "link",
       "nowhere",
       "@tmp/d/dangling"
      ],
      [
       "chown",
       "@tmp/d/f",

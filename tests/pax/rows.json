  {
   "name": "pax-tmp-tree",
   "about": "a tree in /tmp: modes, owners, a link, nested directories, times with nanoseconds",
   "steps": [
    {
     "make": [
      [
       "dir",
       "@tmp/d",
       "0750"
      ],
      [
       "file",
       "@tmp/d/f",
       "f\n",
       "0640"
      ],
      [
       "file",
       "@tmp/d/empty",

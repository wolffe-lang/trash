//! rowtool: the PAX rows' fixture maker and witness (tools/pax-rows.py).
//! PAX's console has no Python, so this static program makes each row's
//! files and prints, as `PAXROW` lines, what the harness on Linux needs to
//! build the same capture the oracle harness builds: each command's exit
//! status and streams, and every entry of a tree, read before anything
//! else reads it. Every name and every stream is printed in hex.
//!
//!   rowtool begin ROW | end ROW            the row's window: the clock, in ms
//!   rowtool clean DIR...                   remove each tree, then make DIR again
//!   rowtool file PATH HEX MODE             a file of those bytes, that mode
//!   rowtool big PATH N                     N bytes, 0..250 repeated
//!   rowtool dir PATH MODE | link TARGET PATH
//!   rowtool chown PATH UID GID             the entry itself, never a link's target
//!   rowtool stamp PATH...                  both times 1700000000, the fixture's
//!   rowtool times PATH MS MNS AS ANS       both times, to the nanosecond
//!   rowtool write PATH HEX                 a command's standard input
//!   rowtool step ROW N STATUS OUT ERR      a command's status and streams
//!   rowtool snap ROW TREE ROOT EXACT       every entry under ROOT

use std.x.crypto.sha2

fn hex(b: List[byte]) -> str {
    if b.len == 0 {
        return "-"
    }
    let digits = "0123456789abcdef"
    var out = List[byte]()
    let d = digits.bytes()
    for x in b {
        let n = x as int
        (mut out).push(d[n / 16])
        (mut out).push(d[n % 16])
    }
    str_from_utf8(out) else "-"
}

fn digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    0
}

fn unhex(h: str) -> List[byte] {
    var out = List[byte]()
    if h == "-" {
        return out
    }
    let b = h.bytes()
    var i = 0
    while i + 1 < b.len {
        (mut out).push((digit(b[i] as int) * 16 + digit(b[i + 1] as int)) as byte)
        i += 2
    }
    out
}

fn oct(n: int) -> str {
    let d = "{n / 512 % 8}{n / 64 % 8}{n / 8 % 8}{n % 8}"
    d
}

fn unoct(s: str) -> int {
    var n: int = 0
    for x in s.bytes() {
        n = n * 8 + (x as int - 48)
    }
    n
}

fn num(s: str) -> int {
    s.to_int() else 0
}

fn fail(what: str) -> int {
    eprint("rowtool: {what}: {os_error_text(os_error())}")
    1
}

/// Remove `path` and everything under it.
fn remove(path: str) {
    let rec = fs_lstat(path) else |_| {
        return
    }
    if rec[0] == 1 {
        fs_set_mode(path, 0o700) else |_| {}
        let entries = fs_read_dir_entries(path) else |_| {
            List[List[byte]]()
        }
        for e in entries {
            let name = str_from_utf8(e[1..]) else |_| {
                continue
            }
            remove("{path}/{name}")
        }
        fs_remove_dir(path) else |_| {}
    } else {
        fs_remove(path) else |_| {}
    }
}

fn parent_dirs(path: str) {
    let cut = path.rfind("/") else -1
    if cut > 0 {
        fs_create_dir_all(path[0..cut]) else |_| {}
    }
}

fn write_file(path: str, data: List[byte], mode: int) -> int {
    parent_dirs(path)
    let fd = fs_open_perm(path, 1, 0o644) else |_| {
        return fail("cannot make {path}")
    }
    if data.len > 0 {
        fs_write_chunk(fd, data) else |_| {
            return fail("cannot write {path}")
        }
    }
    fs_close(fd) else |_| {}
    fs_set_mode(path, mode) else |_| {
        return fail("cannot set the mode of {path}")
    }
    0
}

fn big(path: str, n: int) -> int {
    parent_dirs(path)
    var block = List[byte]()
    var i = 0
    while i < 65536 {
        (mut block).push((i % 251) as byte)
        i += 1
    }
    let fd = fs_open_perm(path, 1, 0o644) else |_| {
        return fail("cannot make {path}")
    }
    var left: int = n
    while left > 0 {
        region piece {
            if left >= 65536 {
                fs_write_chunk(fd, block) else |_| {}
                left -= 65536
            } else {
                var tail = List[byte]()
                var k = 0
                while k < left {
                    (mut tail).push(block[k])
                    k += 1
                }
                fs_write_chunk(fd, tail) else |_| {}
                left = 0
            }
        }
    }
    fs_close(fd) else |_| {}
    0
}

fn sha(path: str) -> str {
    var st = sha2.new256()
    let fd = fs_open(path) else |_| {
        return "-"
    }
    var more = true
    while more {
        region chunk {
            let got = fs_read_chunk(fd, 65536) else |_| {
                more = false
                List[byte]()
            }
            if got.len > 0 {
                sha2.update256(mut st, got)
            }
        }
    }
    fs_close(fd) else |_| {}
    hex(sha2.final256(take st))
}

/// Every entry under `dir` (named `rel` relative to the snapshot's root),
/// each one's record read before anything else reads it.
fn walk(row: str, tree: str, dir: str, rel: List[byte], exact: bool) {
    let entries = fs_read_dir_entries(dir) else |_| {
        return
    }
    for e in entries {
        var r = copy rel
        if r.len > 0 {
            (mut r).push(47 as byte)
        }
        var k = 1
        while k < e.len {
            (mut r).push(e[k])
            k += 1
        }
        let name = str_from_utf8(e[1..]) else |_| {
            print("PAXROW entry {row} {tree} {hex(r)} unreachable")
            continue
        }
        let path = "{dir}/{name}"
        let w = fs_lstat(path) else |_| {
            print("PAXROW entry {row} {tree} {hex(r)} unreachable")
            continue
        }
        let kind = w[0]
        var size = "-"
        var digest = "-"
        var target = "-"
        var text = "-"
        if kind == 0 {
            size = "{w[1]}"
            digest = sha(path)
            if name.ends_with(".trashinfo") {
                text = hex(fs_read_bytes(path) else List[byte]())
            }
        }
        if kind == 3 {
            target = hex(fs_read_link(path) else List[byte]())
        }
        let at = if exact then "{w[12]} {w[13]}" else "- -"
        print(
            "PAXROW entry {row} {tree} {hex(r)} {kind} {oct(w[4])} {w[6]}:{w[7]} {size} {w[14]} {w[15]} {at} {digest} {target} {text}",
        )
        if kind == 1 {
            walk(row, tree, path, r, exact)
        }
    }
}

fn main() -> int {
    let a = env_args()
    if a.len == 0 {
        return fail("no command")
    }
    let c = a[0]
    if (c == "begin" || c == "end") && a.len == 2 {
        print("PAXROW {c} {a[1]} {time_unix_ms()}")
        return 0
    }
    if c == "clean" {
        var i = 1
        while i < a.len {
            remove(a[i])
            fs_create_dir_all(a[i]) else |_| {
                return fail("cannot make {a[i]}")
            }
            i += 1
        }
        return 0
    }
    if c == "file" && a.len == 4 {
        return write_file(a[1], unhex(a[2]), unoct(a[3]))
    }
    if c == "write" && a.len == 3 {
        return write_file(a[1], unhex(a[2]), 0o644)
    }
    if c == "big" && a.len == 3 {
        return big(a[1], num(a[2]))
    }
    if c == "dir" && a.len == 3 {
        fs_create_dir_all(a[1]) else |_| {
            return fail("cannot make {a[1]}")
        }
        fs_set_mode(a[1], unoct(a[2])) else |_| {
            return fail("cannot set the mode of {a[1]}")
        }
        return 0
    }
    if c == "link" && a.len == 3 {
        parent_dirs(a[2])
        fs_symlink(a[1], a[2]) else |_| {
            return fail("cannot link {a[2]}")
        }
        return 0
    }
    if c == "chown" && a.len == 4 {
        fs_set_owner(a[1], num(a[2]), num(a[3]), false) else |_| {
            return fail("cannot chown {a[1]}")
        }
        return 0
    }
    if c == "stamp" {
        var i = 1
        while i < a.len {
            fs_set_times(a[i], 1700000000, 0, 1700000000, 0, false) else |_| {
                return fail("cannot stamp {a[i]}")
            }
            i += 1
        }
        return 0
    }
    if c == "times" && a.len == 6 {
        fs_set_times(a[1], num(a[4]), num(a[5]), num(a[2]), num(a[3]), false) else |_| {
            return fail("cannot set the times of {a[1]}")
        }
        return 0
    }
    if c == "step" && a.len == 6 {
        let out = fs_read_bytes(a[4]) else List[byte]()
        let err = fs_read_bytes(a[5]) else List[byte]()
        print("PAXROW step {a[1]} {a[2]} {a[3]} {hex(out)} {hex(err)}")
        return 0
    }
    if c == "snap" && a.len == 5 {
        walk(a[1], a[2], a[3], List[byte](), a[4] == "1")
        return 0
    }
    fail("usage")
}

#!/usr/bin/env bash
# tools/in-container [CMD...]: build the oracle image from ci/oracle.Containerfile,
# hold it to its pins, then run CMD (default: tools/gate linux) inside it with the
# repository at /work and a tmpfs at /xdev, the second file system the census
# and the cross-device rows need.
#
#   TRASH_ENGINE   podman or docker (default docker)
#   TRASH_CPUS     the CPU list taskset gives every step inside (default 0)
#   TRASH_MEMORY   the container's memory cap (default 12g)
#   TRASH_ARCHIVES a directory of the pinned toolchain archives, mounted read-only
#   TRASH_BOOTSTRAP=1  write ci/packages.lock and ci/oracle-manifest.lock from the
#                  image instead of checking them (a re-pin; nothing else runs)
#   TRASH_PREPARE_ONLY=1  build and check the image, run nothing
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
engine=${TRASH_ENGINE:-docker}
cpus=${TRASH_CPUS:-0}
memory=${TRASH_MEMORY:-12g}
key=$(cat "$root/ci/oracle.Containerfile" "$root/ci/apt-snapshot" "$root/ci/packages.txt" \
    "$root/ci/build-requirements.txt" "$root/ci/oracle-sdist.txt" "$root/ci/oracle-requirements.txt" \
    "$root/ci/oracle-wheel.txt" | sha256sum | cut -c1-20)
image="trash-oracle:$key"
if ! "$engine" image inspect "$image" > /dev/null 2>&1; then
    "$engine" build --build-arg "BUILD_CPUS=$cpus" -f "$root/ci/oracle.Containerfile" -t "$image" "$root"
fi
mkdir -p "$root/target/oracle"
"$engine" image inspect "$image" --format '{{.Id}}' > "$root/target/oracle/image-id.txt"
echo "image $image $(cat "$root/target/oracle/image-id.txt")"
for f in oracle-packages.txt oracle-manifest.txt; do
    "$engine" run --rm --network none --memory "$memory" "$image" taskset -c "$cpus" cat "/opt/$f" > "$root/target/oracle/$f"
done
if [ "${TRASH_BOOTSTRAP:-0}" = 1 ]; then
    cp "$root/target/oracle/oracle-packages.txt" "$root/ci/packages.lock"
    cp "$root/target/oracle/oracle-manifest.txt" "$root/ci/oracle-manifest.lock"
    echo 'PASS oracle-bootstrap: ci/packages.lock and ci/oracle-manifest.lock written from the image'
    exit 0
fi
diff -u "$root/ci/packages.lock" "$root/target/oracle/oracle-packages.txt"
diff -u "$root/ci/oracle-manifest.lock" "$root/target/oracle/oracle-manifest.txt"
echo 'PASS oracle-image-pins: the package closure and the oracle manifest are the committed ones'
[ "${TRASH_PREPARE_ONLY:-0}" != 1 ] || exit 0
[ "$#" -gt 0 ] || set -- bash tools/gate linux
mounts=(-v "$root:/work")
if [ -n "${TRASH_ARCHIVES:-}" ]; then mounts+=(-v "$TRASH_ARCHIVES:/archives:ro" -e TRASH_ARCHIVES=/archives); fi
exec "$engine" run --rm --memory "$memory" --pids-limit 4096 --security-opt label=disable \
    --tmpfs /xdev:rw,exec,mode=1777 "${mounts[@]}" -w /work -e TRASH_CPUS="$cpus" \
    "$image" taskset -c "$cpus" "$@"

def guard_rows(check, t):
    """The baseline guard against real commits, in a repository made for it: a push of two commits whose first
    grows the baseline must fail, though HEAD^1 (its own first commit) already holds the grown baseline."""
    import shutil
    import tempfile
    if not shutil.which("git"):
        check(False, "git is needed for the baseline guard's rows")
        return 1
    rows = 0
    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, HOME=tmp, GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
                   GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@example.invalid",
                   GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@example.invalid")

        def run(*args):
            r = subprocess.run(["git", "-C", tmp, "-c", "commit.gpgsign=false", "-c", "core.hooksPath=" + os.devnull]
                               + list(args), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if r.returncode:
                raise Refused("git %s: %s" % (args[0], r.stderr.decode("utf-8", "replace").strip()))
            return r.stdout.decode().strip()

        def commit(files, message):
            for path, text in files.items():
                full = os.path.join(tmp, path)
                os.makedirs(os.path.dirname(full), exist_ok=True)
                with open(full, "w", encoding="utf-8") as f:
                    f.write(text)
            run("add", "-A")
            run("commit", "-q", "-m", message)
            return run("rev-parse", "HEAD")

        word = t("{q}12")
        run("init", "-q")
        before = commit({"README.md": "clean\n", BASELINE: HEADER}, "the previous tip")
        grown_base = {("README.md", short(word)): 1}
        commit({"README.md": "clean\n%s\n" % word, BASELINE: write_baseline(grown_base)}, "grow the baseline")
        commit({"NOTES.md": "unrelated\n"}, "a second commit")
        _, failed = guard(grown_base, base_rev("push", {"before": before}), root=tmp)
        check(failed, "a two-commit push whose first commit grows the baseline passes the push guard")
        _, failed = guard(grown_base, "HEAD^1", root=tmp)
        check(not failed, "HEAD^1 of that push is its own first commit, which already holds the grown baseline")
        _, failed = guard(grown_base, base_rev("push", {"before": "0" * 40}), root=tmp)
        check(failed, "a push that made its branch with entries in its baseline passes")
        _, failed = guard({}, None, root=tmp)
        check(not failed, "a push that made its branch with an empty baseline fails")
        rows += 4
        for rev, merge, name in [("f" * 40, False, "a REV that names no commit"),
                                 ("HEAD^1", True, "a pull request whose HEAD is no merge commit")]:
            try:
                guard(grown_base, rev, root=tmp, merge=merge)
                check(False, "the guard accepted %s" % name)
            except Refused:
                pass
            rows += 1
    return rows


def main():
    p = argparse.ArgumentParser(description="no internal references in this repository's public text")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--self-test", action="store_true")
    g.add_argument("--shrink", action="store_true")
    g.add_argument("--init", action="store_true")
    g.add_argument("--report", action="store_true")
    g.add_argument("--digest", metavar="WORD")
    g.add_argument("--tool-digest", action="store_true")
    p.add_argument("--all", action="store_true", help="with --report: excluded files too")
    g2 = p.add_mutually_exclusive_group()
    g2.add_argument("--against-rev", metavar="REV")
    g2.add_argument("--against-event", action="store_true")
    a = p.parse_args()
    try:
        if a.self_test:
            return self_test()
        if a.digest is not None:
            print(digest(a.digest.lower()))
            return 0
        if a.tool_digest:
            with open(SELF, "rb") as f:
                print(hashlib.sha256(f.read()).hexdigest())
            return 0
        if a.shrink:
            return shrink()
        if a.init:
            return init()
        if a.report:
            return report(a.all)
        return gate(a.against_rev, a.against_event)
    except Refused as e:
        print("FAIL public-text %s" % e, flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main())

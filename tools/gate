#!/usr/bin/env bash
# tools/gate [unit|candidate|linux]: the repository's gate. Every step prints
# START and END NAME exit=N; the first nonzero step stops it (set -e), and its
# exit is the gate's.
#   unit       what needs no toolchain and no oracle: the pins, the harnesses'
#              own tests, the census expectations, the expected captures.
#   candidate  inside the oracle image: the toolchain, the formatter, the
#              commands built, their unit programs, the five built static
#              from two copies of the tree at two paths and held to each
#              other by digest, and again with an ld.lld on PATH
#              (tools/repro.py), the commands held to
#              the oracle's rows, and the hardening rows: each command cut
#              at each durable step, two run at once, and GNU rm's own
#              answers on the permission rows' fixtures (a witness).
#   linux      everything, inside the oracle image (tools/in-container runs it):
#              the toolchain by digest, the formatter, the census built and run
#              on Linux and held to census/expect.json, the static census and
#              commands for PAX (and the five again from two copies of the
#              tree, held to each other by digest, and with an ld.lld on
#              PATH), the oracle's rows on the
#              oracle, the
#              commands held to them, and the hardening rows.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
mode=${1:-unit}
case "$mode" in unit|candidate|linux) ;; *) echo "FAIL gate-mode: $mode"; exit 2 ;; esac
rm -rf target/gate target/home target/tmp
mkdir -p target/gate target/home target/tmp
export HOME="$root/target/home"
export XDG_CACHE_HOME="$HOME/cache"
export TMPDIR="$root/target/tmp"
export LC_ALL=C.UTF-8 TERM=dumb
unset TZ
source "$root/tools/gate-steps.sh"
step pin-metadata python3 -I tools/check-pins.py
step census-selftest python3 -I tools/census.py selftest
step census-pax-selftest python3 -I tools/census-pax.py selftest
step oracle-selftest python3 -I tools/oracle.py selftest
step expected-statements python3 -I tools/expected.py check
step pax-rows-selftest python3 -I tools/pax-rows.py selftest
step harden-selftest python3 -I tools/harden.py selftest
step repro-selftest python3 -I tools/repro.py selftest
[ "$mode" != unit ] || exit 0
[ -f /opt/oracle-manifest.txt ] || { echo 'FAIL gate-linux-outside-the-image: run it through tools/in-container'; exit 2; }
stage=$root/.wolf-bin
fetch=(python3 -I tools/fetch-toolchain.py --out "$stage")
if [ -n "${TRASH_ARCHIVES:-}" ]; then fetch+=(--archive-dir "$TRASH_ARCHIVES"); fi
step toolchain "${fetch[@]}"
wolf=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["tools"]["wolf"]["root"]+"/wolf")' "$stage/manifest.json")
step wolf-fmt "$wolf" fmt --check census src tests/pax/rowtool
if [ "$mode" = candidate ]; then
    rm -rf target/bin target/unit
    step trash-build python3 -I tools/build.py --wolf "$wolf" --out target/bin
    step trash-unit python3 -I tools/unit.py --wolf "$wolf" --out target/unit
    step repro python3 -I tools/repro.py run --wolf "$wolf" --out target/repro
    step oracle-compare python3 -I tools/oracle.py compare --rows tests/oracle/rows.json --candidate target/bin
    step harden-cuts python3 -I tools/harden.py cuts --rows tests/cuts/rows.json --candidate target/bin
    step harden-stress python3 -I tools/harden.py stress --rows tests/cuts/stress.json --candidate target/bin \
        --rounds 100 --seed 20261108
    step rm-witness python3 -I tools/harden.py rm-witness --rows tests/oracle/rows.json --only '^perm-'
    exit 0
fi
rm -rf target/census target/census-bin target/census-static /xdev/census target/bin target/static target/unit
step census-build python3 -I tools/census.py build --wolf "$wolf" --out target/census-bin
step census-linux python3 -I tools/census.py run --bin target/census-bin --same target/census/same \
    --other /xdev/census --out target/census/linux.json
step census-linux-verdict python3 -I tools/census.py verdict --record target/census/linux.json --platform linux
step census-static python3 -I tools/census.py build --wolf "$wolf" --out target/census-static --static
step trash-build python3 -I tools/build.py --wolf "$wolf" --out target/bin
step trash-unit python3 -I tools/unit.py --wolf "$wolf" --out target/unit
step trash-static python3 -I tools/build.py --wolf "$wolf" --out target/static --static
step repro python3 -I tools/repro.py run --wolf "$wolf" --out target/repro
step rowtool-static python3 -I tools/build.py --wolf "$wolf" --out target/static --static \
    --entry tests/pax/rowtool/main.lu:rowtool
step oracle-live-selftest python3 -I tools/oracle.py selftest --live --rows tests/oracle/rows.json
step oracle-goldens python3 -I tools/oracle.py check --rows tests/oracle/rows.json --golden tests/oracle/golden
step oracle-compare python3 -I tools/oracle.py compare --rows tests/oracle/rows.json --candidate target/bin
step harden-cuts python3 -I tools/harden.py cuts --rows tests/cuts/rows.json --candidate target/bin
step harden-stress python3 -I tools/harden.py stress --rows tests/cuts/stress.json --candidate target/bin \
    --rounds 100 --seed 20261108
step rm-witness python3 -I tools/harden.py rm-witness --rows tests/oracle/rows.json --only '^perm-'

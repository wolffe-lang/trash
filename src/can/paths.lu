// can: paths, as the oracle reads an operand and writes `Path=`.

/// `p` made absolute against `cwd` and read lexically: repeated slashes are
/// one, `.` goes, `..` takes the component before it (never past the root),
/// and a trailing slash goes. No link is resolved: `lq/../x` is `./x`, as
/// the oracle reads it. The root stays `/`, however many slashes lead.
pub fn absolute(cwd: str, p: str) -> str {
    let joined = if p.starts_with("/") then p else "{cwd}/{p}"
    var parts = List[str]()
    for c in joined.split("/") {
        if c.len == 0 || c == "." {
            continue
        }
        if c == ".." {
            if parts.len > 0 {
                let _ = (mut parts).pop() else ""
            }
            continue
        }
        (mut parts).push(c)
    }
    if parts.len == 0 {
        return "/"
    }
    var out = ""
    for c in parts {
        out += "/"
        out += c
    }
    out
}

/// The last component of an absolute, normalised path (`` for `/`).
pub fn base(p: str) -> str {
    let cut = p.rfind("/") else -1
    if cut < 0 then p else p[cut + 1..]
}

/// The directory an absolute, normalised path is in (`/` for `/x`).
pub fn parent(p: str) -> str {
    let cut = p.rfind("/") else -1
    if cut <= 0 then "/" else p[0..cut]
}

/// `p` without its trailing slashes; a path of slashes alone is `/`.
pub fn unslashed(p: str) -> str {
    let b = p.bytes()
    var end = b.len
    while end > 0 && b[end - 1] as int == 47 {
        end -= 1
    }
    if end == 0 && p.len > 0 {
        return "/"
    }
    p[0..end]
}

/// `Path=`'s encoding: every byte outside RFC 3986's unreserved set
/// (letters, digits, `-._~`) and `/` as `%HH`, upper-case hex.
pub fn encode(p: str) -> str {
    var out = List[byte]()
    for x in p.bytes() {
        let c = x as int
        let keep = c >= 65 && c <= 90 ||
            c >= 97 && c <= 122 ||
            c >= 48 && c <= 57 ||
            c == 45 ||
            c == 46 ||
            c == 95 ||
            c == 126 ||
            c == 47
        if keep {
            (mut out).push(x)
        } else {
            for y in "%{hex2(c, true)}".bytes() {
                (mut out).push(y)
            }
        }
    }
    str_from_utf8(out) else ""
}

/// Whether `inner` is `outer` or lies under it, both absolute and normalised.
pub fn under(inner: str, outer: str) -> bool {
    if inner == outer {
        return true
    }
    if outer == "/" {
        return true
    }
    inner.starts_with("{outer}/")
}

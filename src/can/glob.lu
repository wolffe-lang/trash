// can: trash-rm's patterns, matched as the oracle matches them: Python's
// `fnmatch.fnmatchcase` rules, measured row by row (notes/tb02-the-
// companions.md). `*` is any run of characters, `/` included; `?` is any
// one; `[…]` is one of a set (`a-z` a range, `!` first a negation, `]`
// first a member); a `[` with no `]` after it is itself; nothing escapes.
// Characters are code points; a byte that is not UTF-8 is one character
// of its own.

/// The characters of `b`: code points, and 0x110000 + the byte for a byte
/// that starts no well-formed sequence.
pub fn code_points(b: List[byte]) -> List[int] {
    var out = List[int]()
    var i = 0
    while i < b.len {
        let n = utf8_run(b, i)
        if n == 0 {
            (mut out).push(1114112 + b[i] as int)
            i += 1
            continue
        }
        let c = b[i] as int
        var cp = c
        if n == 2 {
            cp = c % 32
        } else if n == 3 {
            cp = c % 16
        } else if n == 4 {
            cp = c % 8
        }
        var k = 1
        while k < n {
            cp = cp * 64 + b[i + k] as int % 64
            k += 1
        }
        (mut out).push(cp)
        i += n
    }
    out
}

/// Where the set that opens at `i` (a `[`) closes: the index of its `]`,
/// or -1 when there is none, and `[` is then itself.
fn set_end(p: List[int], i: int) -> int {
    var j = i + 1
    if j < p.len && p[j] == 33 {
        j += 1
    }
    if j < p.len && p[j] == 93 {
        j += 1
    }
    while j < p.len && p[j] != 93 {
        j += 1
    }
    if j >= p.len then -1 else j
}

/// Whether `c` is in the set `p[from..to]` (the characters between `[`
/// and `]`).
fn in_set(p: List[int], from: int, to: int, c: int) -> bool {
    var i = from
    var neg = false
    if i < to && p[i] == 33 {
        neg = true
        i += 1
    }
    var hit = false
    var first = true
    while i < to {
        let a = p[i]
        if i + 2 < to && p[i + 1] == 45 {
            let b = p[i + 2]
            if a <= c && c <= b {
                hit = true
            }
            i += 3
        } else {
            if a == c {
                hit = true
            }
            i += 1
        }
        first = false
    }
    if first {
        return neg
    }
    if neg then !hit else hit
}

/// Whether the pattern `p` matches the whole of `s`.
pub fn matches(p: List[int], s: List[int]) -> bool {
    var pi = 0
    var si = 0
    var star = -1
    var mark = 0
    while si < s.len {
        if pi < p.len && p[pi] == 42 {
            star = pi
            pi += 1
            mark = si
            continue
        }
        if pi < p.len {
            let c = p[pi]
            var next = -1
            if c == 63 {
                next = pi + 1
            } else if c == 91 {
                let end = set_end(p, pi)
                if end < 0 {
                    if s[si] == 91 {
                        next = pi + 1
                    }
                } else if in_set(p, pi + 1, end, s[si]) {
                    next = end + 1
                }
            } else if c == s[si] {
                next = pi + 1
            }
            if next >= 0 {
                pi = next
                si += 1
                continue
            }
        }
        if star >= 0 {
            pi = star + 1
            mark += 1
            si = mark
            continue
        }
        return false
    }
    while pi < p.len && p[pi] == 42 {
        pi += 1
    }
    pi == p.len
}

/// Whether trash-rm's pattern takes an item whose original path is `path`:
/// its last component, or the whole path when the pattern starts with `/`.
pub fn takes(pattern: List[byte], path: List[byte]) -> bool {
    let p = code_points(pattern)
    if pattern.len > 0 && pattern[0] as int == 47 {
        return matches(p, code_points(path))
    }
    var cut = path.len
    while cut > 0 && path[cut - 1] as int != 47 {
        cut -= 1
    }
    matches(p, code_points(path[cut..]))
}

//! member: false
//!
//! The pure parts of `can`, by name: words in messages, paths read
//! lexically, `Path=`'s encoding, collision names and their shortening, the
//! info text, the deletion date, and the argument parser on the shapes the
//! oracle answered (tests/oracle/golden), and the companions' pure parts:
//! info files read, dates read and cut, patterns matched, the companions'
//! command lines and restore's answers; and the hardening's: the cut
//! hook's counters, and which reservations a rerun may take back. Each
//! check prints `PASS row` or
//! `FAIL row got … want …`; tests/unit-rows.json lists the rows.

use can

struct Tally {
    failed: int,
}

fn check(mut t: Tally, row: str, got: str, want: str) {
    if got == want {
        print("PASS {row}")
    } else {
        print("FAIL {row} got [{got}] want [{want}]")
        t.failed += 1
    }
}

fn bytes(xs: List[int]) -> List[byte] {
    var out = List[byte]()
    for x in xs {
        (mut out).push(x as byte)
    }
    out
}

fn text_rows(mut t: Tally) {
    check(mut t, "shown-utf8", can.shown(can.bytes_of("my file é")), "my file é")
    check(mut t, "shown-ff", can.shown(bytes([120, 255, 121])), "x\\xffy")
    check(mut t, "shown-overlong", can.shown(bytes([192, 128])), "\\xc0\\x80")
    check(mut t, "shown-surrogate", can.shown(bytes([237, 160, 128])), "\\xed\\xa0\\x80")
    check(mut t, "shown-past-max", can.shown(bytes([244, 144, 128, 128])), "\\xf4\\x90\\x80\\x80")
    check(mut t, "shown-cut", can.shown(bytes([195])), "\\xc3")
    check(mut t, "chars", "{can.chars("aéb€")}", "4")
    check(mut t, "first-chars", can.first_chars("aéb€", 2), "aé")
    check(mut t, "first-chars-all", can.first_chars("ab", 5), "ab")
}

fn path_rows(mut t: Tally) {
    check(mut t, "absolute-relative", can.absolute("/h", "a"), "/h/a")
    check(mut t, "absolute-dotdot", can.absolute("/h/sub", "../x"), "/h/x")
    check(mut t, "absolute-dot", can.absolute("/h/sub", "./y"), "/h/sub/y")
    check(mut t, "absolute-lexical", can.absolute("/h", "lq/../x"), "/h/x")
    check(mut t, "absolute-slash", can.absolute("/h", "d/"), "/h/d")
    check(mut t, "absolute-root-dotdot", can.absolute("/", "../.."), "/")
    check(mut t, "absolute-two-slashes", can.absolute("/h", "//"), "/")
    check(mut t, "absolute-climb", can.absolute("/h", "/tmp/../.."), "/")
    check(mut t, "absolute-repeated", can.absolute("/h", "a//b/./c"), "/h/a/b/c")
    check(mut t, "base", can.base("/h/a.txt"), "a.txt")
    check(mut t, "parent", can.parent("/h/a.txt"), "/h")
    check(mut t, "parent-top", can.parent("/a"), "/")
    check(mut t, "unslashed", can.unslashed("deeper/.//"), "deeper/.")
    check(mut t, "unslashed-root", can.unslashed("///"), "/")
    check(mut t, "unslashed-none", can.unslashed("a"), "a")
    check(mut t, "unslashed-utf8", can.unslashed("ééé"), "ééé")
    check(mut t, "unslashed-utf8-slash", can.unslashed("é/"), "é")
    check(mut t, "encode-unreserved", can.encode("/A-Z_a.z~0/9"), "/A-Z_a.z~0/9")
    check(mut t, "encode-space-utf8", can.encode("/h/my file é.txt"), "/h/my%20file%20%C3%A9.txt")
    // The oracle's encoding of every ASCII punctuation mark (put-punctuation).
    check(
        mut t,
        "encode-punctuation",
        can.encode("a%b#c?d+e&f=g;h~i@j!k'l(m)n*o,p$q[r]s{{t}}u^v`w|x\"y<z>_-.:"),
        "a%25b%23c%3Fd%2Be%26f%3Dg%3Bh~i%40j%21k%27l%28m%29n%2Ao%2Cp%24q%5Br%5Ds%7Bt%7Du%5Ev%60w%7Cx%22y%3Cz%3E_-.%3A",
    )
    check(mut t, "encode-control", can.encode("tab\there\nnl"), "tab%09here%0Anl")
    check(mut t, "under-self", "{can.under("/h/Trash", "/h/Trash")}", "true")
    check(mut t, "under-inside", "{can.under("/h/Trash/files/a", "/h/Trash")}", "true")
    check(mut t, "under-sibling", "{can.under("/h/Trashy", "/h/Trash")}", "false")
}

fn name_rows(mut t: Tally) {
    check(mut t, "candidate-first", can.candidate("a.txt", 0, false), "a.txt")
    check(mut t, "candidate-second", can.candidate("a.txt", 1, false), "a.txt_1")
    check(mut t, "candidate-third", can.candidate(".hidden", 2, false), ".hidden_2")
    let n246 = "n".repeat(246)
    check(mut t, "candidate-short", can.candidate(n246, 1, true), "{"n".repeat(234)}_1")
    check(mut t, "candidate-short-ten", can.candidate(n246, 10, true), "{"n".repeat(233)}_10")
    check(
        mut t,
        "candidate-short-utf8",
        can.candidate("é".repeat(125), 1, true),
        "{"é".repeat(113)}_1",
    )
    check(mut t, "too-long-245", "{can.too_long("n".repeat(245), 255)}", "false")
    check(mut t, "too-long-246", "{can.too_long(n246, 255)}", "true")
    check(mut t, "too-long-utf8", "{can.too_long("é".repeat(123), 255)}", "true")
    check(
        mut t,
        "info-text",
        can.info_text("/h/a b", "2026-11-08T12:00:00"),
        "[Trash Info]\nPath=/h/a%20b\nDeletionDate=2026-11-08T12:00:00\n",
    )
}

fn date_rows(mut t: Tally) {
    env_set("TZ", "UTC0") else |_| {}
    check(mut t, "date-utc", can.deletion_date(1700000000), "2023-11-14T22:13:20")
    env_set("TZ", "JST-9") else |_| {}
    check(mut t, "date-east", can.deletion_date(1700000000), "2023-11-15T07:13:20")
    env_set("TZ", "PST8") else |_| {}
    check(mut t, "date-west", can.deletion_date(1700000000), "2023-11-14T14:13:20")
    env_set("TZ", "Nowhere/None") else |_| {}
    check(mut t, "date-no-zone-is-utc", can.deletion_date(1700000000), "2023-11-14T22:13:20")
}

fn nothing_exists(w: List[byte]) -> bool {
    w.len < 0
}

/// Files named `-v`, `-1` and `--verbose` are there.
fn some_exist(w: List[byte]) -> bool {
    let s = str_from_utf8(w) else |_| {
        return false
    }
    s == "-v" || s == "-1" || s == "--verbose"
}

fn words(line: str) -> List[List[byte]] {
    var out = List[List[byte]]()
    if line.len == 0 {
        return out
    }
    for w in line.split(" ") {
        (mut out).push(can.bytes_of(w))
    }
    out
}

fn parsed(line: str, exists: fn(List[byte]) -> bool) -> str {
    let a = can.parse(words(line), exists)
    var ops = ""
    for o in a.operands {
        ops += "[{can.shown(o)}]"
    }
    "f={a.force} i={a.interactive} v={a.verbose} h={a.help} V={a.version} ops={ops} err={a.error}"
}

fn arg_rows(mut t: Tally) {
    let no = nothing_exists
    let none = "f=false i=false v=false h=false V=false"
    check(mut t, "args-plain", parsed("a b", no), "{none} ops=[a][b] err=")
    check(mut t, "args-none", parsed("", no), "{none} ops= err=Please specify the files to trash.")
    check(
        mut t,
        "args-force-none",
        parsed("-f", no),
        "f=true i=false v=false h=false V=false ops= err=Please specify the files to trash.",
    )
    check(
        mut t,
        "args-cluster",
        parsed("-rfv a", no),
        "f=true i=false v=true h=false V=false ops=[a] err=",
    )
    check(
        mut t,
        "args-fi",
        parsed("-fi a", no),
        "f=false i=true v=false h=false V=false ops=[a] err=",
    )
    check(
        mut t,
        "args-if",
        parsed("-if a", no),
        "f=true i=false v=false h=false V=false ops=[a] err=",
    )
    check(
        mut t,
        "args-after",
        parsed("a -v", no),
        "f=false i=false v=true h=false V=false ops=[a] err=",
    )
    check(mut t, "args-dashdash", parsed("-- -foo -v", no), "{none} ops=[-foo][-v] err=")
    check(mut t, "args-dash", parsed("-", no), "{none} ops=[-] err=")
    check(mut t, "args-negative", parsed("-1 -.5", no), "{none} ops=[-1][-.5] err=")
    check(
        mut t,
        "args-unknown",
        parsed("-x a", no),
        "{none} ops=[a] err=unrecognized arguments: -x",
    )
    check(
        mut t,
        "args-unknown-tail",
        parsed("-vx a", no),
        "f=false i=false v=true h=false V=false ops=[a] err=unrecognized arguments: -x",
    )
    check(
        mut t,
        "args-unknown-head",
        parsed("-xv a", no),
        "{none} ops=[a] err=unrecognized arguments: -xv",
    )
    check(
        mut t,
        "args-unknown-middle",
        parsed("-vxq a", no),
        "f=false i=false v=true h=false V=false ops=[a] err=unrecognized arguments: -xq",
    )
    check(
        mut t,
        "args-unknown-two",
        parsed("--nope -q a", no),
        "{none} ops=[a] err=unrecognized arguments: --nope -q",
    )
    check(
        mut t,
        "args-long",
        parsed("--force --verbose --recursive --directory a", no),
        "f=true i=false v=true h=false V=false ops=[a] err=",
    )
    check(
        mut t,
        "args-prefix",
        parsed("--verb a", no),
        "f=false i=false v=true h=false V=false ops=[a] err=",
    )
    check(
        mut t,
        "args-ambiguous",
        parsed("--v a", no),
        "{none} ops= err=ambiguous option: --v could match --verbose, --version",
    )
    check(
        mut t,
        "args-explicit",
        parsed("--verbose=1 a", no),
        "{none} ops= err=argument -v/--verbose: ignored explicit argument '1'",
    )
    check(
        mut t,
        "args-explicit-short",
        parsed("-v=1 a", no),
        "{none} ops= err=argument -v/--verbose: ignored explicit argument '1'",
    )
    check(
        mut t,
        "args-trash-dir",
        parsed("--trash-dir /t a", no),
        "{none} ops=[/t][a] err=unrecognized arguments: --trash-dir",
    )
    check(
        mut t,
        "args-help-wins",
        parsed("--nope --help a", no),
        "f=false i=false v=false h=true V=false ops= err=",
    )
    check(
        mut t,
        "args-help-short",
        parsed("-x -h", no),
        "f=false i=false v=false h=true V=false ops= err=",
    )
    check(
        mut t,
        "args-version",
        parsed("--version a", no),
        "f=false i=false v=false h=false V=true ops= err=",
    )
    check(
        mut t,
        "args-existing-flag",
        parsed("-v a", some_exist),
        "{none} ops= err=refusing to treat existing file -v as an option (use './-v' or a '--' separator)",
    )
    check(
        mut t,
        "args-existing-long",
        parsed("--verbose a", some_exist),
        "{none} ops= err=refusing to treat existing file --verbose as an option (use './--verbose' or a '--' separator)",
    )
    check(
        mut t,
        "args-existing-first",
        parsed("-q -1", some_exist),
        "{none} ops= err=refusing to treat existing file -1 as an option (use './-1' or a '--' separator)",
    )
    check(
        mut t,
        "args-existing-after-dashdash",
        parsed("-- -1", some_exist),
        "{none} ops=[-1] err=",
    )
    check(mut t, "args-space", parsed("x", no), "{none} ops=[x] err=")
}

fn shown_ints(xs: List[int]) -> str {
    var out = ""
    for x in xs {
        out += if out.len == 0 then "{x}" else ",{x}"
    }
    "[{out}]"
}

fn bstr(s: str) -> List[byte] {
    can.bytes_of(s)
}

fn info_rows(mut t: Tally) {
    check(mut t, "decode-space", can.shown(can.decode(bstr("a%20b"))), "a b")
    check(mut t, "decode-lower", can.shown(can.decode(bstr("lower%e9"))), "lower\\xe9")
    check(mut t, "decode-slash-pct", can.shown(can.decode(bstr("a%2Fb%25"))), "a/b%")
    check(mut t, "decode-not-hex", can.shown(can.decode(bstr("zz%zz trail%"))), "zz%zz trail%")
    check(mut t, "decode-cut", can.shown(can.decode(bstr("half%4"))), "half%4")
    check(mut t, "decode-plus", can.shown(can.decode(bstr("a+b"))), "a+b")
    var parts = ""
    for line in can.lines_of(bstr("a\r\nb\rc\nd")) {
        parts += "[{can.shown(line)}]"
    }
    check(mut t, "lines-ends", parts, "[a][b][c][d]")
    let (h1, p1, d1) = can.parse_info(
        bstr("[Trash Info]\nPath=/a\nPath=/b\nDeletionDate=2020-01-02T03:04:05\nDeletionDate=x\n"),
    )
    check(mut t, "info-firsts", "{h1} {can.shown(p1)} {d1}", "true /a 2020-01-02T03:04:05")
    let (h2, _, d2) = can.parse_info(bstr("[Trash Info]\nDeletionDate=2020-01-02T03:04:05\n"))
    check(mut t, "info-no-path", "{h2} {d2}", "false 2020-01-02T03:04:05")
    let (h3, p3, d3) = can.parse_info(bstr("Path=docs/rel\r\nDeletionDate=garbage\r\n"))
    check(mut t, "info-relative-crlf", "{h3} {can.shown(p3)} [{d3}]", "true /docs/rel []")
    let (h4, _, _) = can.parse_info(List[byte]())
    check(mut t, "info-empty", "{h4}", "false")
}

fn date_shape_rows(mut t: Tally) {
    check(mut t, "date-padded", can.read_date(bstr("2020-1-2T3:4:5")), "2020-01-02T03:04:05")
    check(mut t, "date-lower-t", can.read_date(bstr("2020-01-02t03:04:05")), "2020-01-02T03:04:05")
    check(
        mut t,
        "date-space-day",
        can.read_date(bstr("2020-01- 2T03:04:05")),
        "2020-01-02T03:04:05",
    )
    check(mut t, "date-year-999", can.read_date(bstr("0999-01-01T00:00:00")), "0999-01-01T00:00:00")
    check(mut t, "date-year-0", can.read_date(bstr("0000-01-01T00:00:00")), "")
    check(mut t, "date-year-5", can.read_date(bstr("20201-01-01T00:00:00")), "")
    check(mut t, "date-month-13", can.read_date(bstr("2020-13-01T00:00:00")), "")
    check(mut t, "date-leap", can.read_date(bstr("2020-02-29T00:00:00")), "2020-02-29T00:00:00")
    check(mut t, "date-not-leap", can.read_date(bstr("2021-02-29T00:00:00")), "")
    check(mut t, "date-hour-24", can.read_date(bstr("2020-01-02T24:00:00")), "")
    check(mut t, "date-second-60", can.read_date(bstr("2020-01-02T03:04:60")), "")
    check(mut t, "date-leading-space", can.read_date(bstr(" 2020-01-02T03:04:05")), "")
    check(mut t, "date-trailing", can.read_date(bstr("2020-01-02T03:04:05Z")), "")
    check(mut t, "date-fraction", can.read_date(bstr("2020-01-02T03:04:05.123")), "")
    check(mut t, "date-empty", can.read_date(List[byte]()), "")
    check(mut t, "listed-date", can.listed_date("2020-01-02T03:04:05"), "2020-01-02 03:04:05")
    check(mut t, "listed-no-date", can.listed_date(""), "????-??-?? ??:??:??")
}

fn civil_rows(mut t: Tally) {
    check(mut t, "civil-epoch", "{can.days_from_civil(1970, 1, 1)}", "0")
    check(
        mut t,
        "civil-leap-day",
        "{can.days_from_civil(2000, 3, 1) - can.days_from_civil(2000, 2, 28)}",
        "2",
    )
    var trips = ""
    for z in [-1000000, -1, 0, 59, 10957, 2932896] {
        let (y, m, d) = can.civil_from_days(z)
        trips += if can.days_from_civil(y, m, d) == z then "y" else "n"
    }
    check(mut t, "civil-round-trip", trips, "yyyyyy")
    let (y0, m0, d0) = can.civil_from_days(-1)
    check(mut t, "civil-before-epoch", "{y0}-{m0}-{d0}", "1969-12-31")
    env_set("TZ", "UTC0") else |_| {}
    check(mut t, "cutoff-utc", can.cutoff(864000, 1), "1970-01-10T00:00:00")
    check(mut t, "cutoff-zero", can.cutoff(864000, 0), "1970-01-11T00:00:00")
    check(mut t, "cutoff-negative", can.cutoff(864000, -1), "1970-01-12T00:00:00")
    check(mut t, "cutoff-far", can.cutoff(864000, 10000000), "0000-00-00T00:00:00")
    env_set("TZ", "CET-1CEST,M3.5.0,M10.5.0/3") else |_| {}
    check(mut t, "cutoff-summer-time", can.cutoff(1794139200, 180), "2026-05-12T13:00:00")
    env_set("TZ", "UTC0") else |_| {}
    check(
        mut t,
        "older-before",
        "{can.older("2020-01-01T00:00:00", "2021-01-01T00:00:00")}",
        "true",
    )
    check(mut t, "older-at", "{can.older("2021-01-01T00:00:00", "2021-01-01T00:00:00")}", "true")
    check(
        mut t,
        "older-after",
        "{can.older("2021-01-01T00:00:01", "2021-01-01T00:00:00")}",
        "false",
    )
    check(mut t, "older-no-date", "{can.older("", "2021-01-01T00:00:00")}", "false")
}

fn takes(pattern: str, path: str) -> str {
    "{can.takes(bstr(pattern), bstr(path))}"
}

fn glob_rows(mut t: Tally) {
    check(mut t, "glob-star", takes("*.txt", "/h/a.txt"), "true")
    check(mut t, "glob-star-no", takes("*.txt", "/h/c.log"), "false")
    check(mut t, "glob-question", takes("?.txt", "/h/ab.txt"), "false")
    check(mut t, "glob-set", takes("[ab].txt", "/h/b.txt"), "true")
    check(mut t, "glob-negated", takes("[!a].txt", "/h/a.txt"), "false")
    check(mut t, "glob-range", takes("[a-c]x", "/h/bx"), "true")
    check(mut t, "glob-range-reversed", takes("[c-a]x", "/h/bx"), "false")
    check(mut t, "glob-bracket-first", takes("[]]", "/h/]"), "true")
    check(mut t, "glob-unclosed", takes("[a", "/h/[a"), "true")
    check(mut t, "glob-no-escape", takes("a\\*", "/h/a\\x"), "true")
    check(mut t, "glob-basename", takes("a.txt", "/h/sub/a.txt"), "true")
    check(mut t, "glob-full-path", takes("/h/*/a.txt", "/h/s/d/a.txt"), "true")
    check(mut t, "glob-full-path-no", takes("/h/*/a.txt", "/h/a.txt"), "false")
    check(mut t, "glob-utf8", takes("?.txt", "/h/é.txt"), "true")
    check(mut t, "glob-star-backtrack", takes("*a*b", "/h/xaybzb"), "true")
}

fn int_text(s: str) -> str {
    let (ok, n) = can.read_int(bstr(s))
    if ok then "{n}" else "no"
}

fn int_rows(mut t: Tally) {
    check(mut t, "int-plain", int_text("12"), "12")
    check(mut t, "int-spaces", int_text(" 7 "), "7")
    check(mut t, "int-plus", int_text("+1"), "1")
    check(mut t, "int-minus", int_text("-1"), "-1")
    check(mut t, "int-underscore", int_text("1_0"), "10")
    check(mut t, "int-two-underscores", int_text("1__0"), "no")
    check(mut t, "int-fraction", int_text("1.5"), "no")
    check(mut t, "int-empty", int_text(""), "no")
    check(mut t, "int-blank", int_text("   "), "no")
}

fn line_text(l: can.Line) -> str {
    var ops = ""
    for o in l.operands {
        ops += "[{can.shown(o)}]"
    }
    "h={l.help} v={l.version} ask={l.ask} verbose={l.verbose} dry={l.dry_run} sort={l.sort} ops={ops} err={l.error}"
}

fn opts_rows(mut t: Tally) {
    let none = "h=false v=false ask=0 verbose=false dry=false"
    check(
        mut t,
        "opts-unknown",
        line_text(can.read_args(words("-x"), can.list_opts(), 0)),
        "{none} sort=date ops= err=unrecognized arguments: -x",
    )
    check(
        mut t,
        "opts-extra",
        line_text(can.read_args(words("a b"), can.list_opts(), 0)),
        "{none} sort=date ops= err=unrecognized arguments: a b",
    )
    check(
        mut t,
        "opts-sort-equals",
        line_text(can.read_args(words("--sort=path"), can.restore_opts(), 1)),
        "{none} sort=path ops= err=",
    )
    check(
        mut t,
        "opts-sort-next",
        line_text(can.read_args(words("--sort none p"), can.restore_opts(), 1)),
        "{none} sort=none ops=[p] err=",
    )
    check(
        mut t,
        "opts-sort-prefix",
        line_text(can.read_args(words("--so path"), can.restore_opts(), 1)),
        "{none} sort=path ops= err=",
    )
    check(
        mut t,
        "opts-sort-bad",
        line_text(can.read_args(words("--sort bogus"), can.restore_opts(), 1)),
        "{none} sort=date ops= err=argument --sort: invalid choice: 'bogus' (choose from 'date', 'path', 'none')",
    )
    check(
        mut t,
        "opts-sort-missing",
        line_text(can.read_args(words("--sort"), can.restore_opts(), 1)),
        "{none} sort=date ops= err=argument --sort: expected one argument",
    )
    check(
        mut t,
        "opts-last-f",
        line_text(can.read_args(words("-i -f"), can.empty_opts(), 1)),
        "h=false v=false ask=2 verbose=false dry=false sort=date ops= err=",
    )
    check(
        mut t,
        "opts-last-i",
        line_text(can.read_args(words("-fi"), can.empty_opts(), 1)),
        "h=false v=false ask=1 verbose=false dry=false sort=date ops= err=",
    )
    check(
        mut t,
        "opts-negative",
        line_text(can.read_args(words("-1"), can.empty_opts(), 1)),
        "{none} sort=date ops=[-1] err=",
    )
    check(
        mut t,
        "opts-dashdash",
        line_text(can.read_args(words("-- -x"), can.empty_opts(), 1)),
        "{none} sort=date ops=[-x] err=",
    )
    check(
        mut t,
        "opts-help-wins",
        line_text(can.read_args(words("-x --help"), can.list_opts(), 0)),
        "h=true v=false ask=0 verbose=false dry=false sort=date ops= err=",
    )
    check(
        mut t,
        "opts-explicit",
        line_text(can.read_args(words("--help=1"), can.list_opts(), 0)),
        "{none} sort=date ops= err=argument -h/--help: ignored explicit argument '1'",
    )
    check(
        mut t,
        "opts-cluster-unknown",
        line_text(can.read_args(words("-vxq"), can.empty_opts(), 1)),
        "h=false v=false ask=0 verbose=true dry=false sort=date ops= err=unrecognized arguments: -xq",
    )
    check(
        mut t,
        "opts-unknown-first",
        line_text(can.read_args(words("--trash-dir /t"), can.empty_opts(), 1)),
        "{none} sort=date ops=[/t] err=unrecognized arguments: --trash-dir",
    )
}

fn choice_text(answer: str) -> str {
    let (picked, bad) = can.choose(answer, 2)
    if bad.len > 0 then "error: {bad}" else shown_ints(picked)
}

fn restore_rows(mut t: Tally) {
    check(mut t, "quote-plain", can.py_quote("a b"), "'a b'")
    check(mut t, "quote-single", can.py_quote("it's"), "\"it's\"")
    check(mut t, "quote-both", can.py_quote("a'b\"c"), "'a\\'b\"c'")
    check(mut t, "quote-newline", can.py_quote("a\nb"), "'a\\nb'")
    check(mut t, "errno-line", can.errno_line(2, "/x"), "[Errno 2] No such file or directory: '/x'")
    check(mut t, "choose-one", choice_text("1"), "[1]")
    check(mut t, "choose-list", choice_text("2,0"), "[2,0]")
    check(mut t, "choose-span", choice_text("0-2"), "[0,1,2]")
    check(mut t, "choose-span-reversed", choice_text("2-0"), "[]")
    check(mut t, "choose-spaces", choice_text(" 1 , 2"), "[1,2]")
    check(mut t, "choose-open", choice_text("1-"), "error: open interval: 1-")
    check(mut t, "choose-dash", choice_text("-1"), "error: open interval: -1")
    check(mut t, "choose-word", choice_text("1,x"), "error: not an index: x")
    check(mut t, "choose-empty-piece", choice_text("0,,1"), "error: not an index: ")
    check(mut t, "choose-out", choice_text("0,5"), "error: out of range 0..2: 5")
    check(mut t, "choose-span-out", choice_text("1-9"), "error: out of range 0..2: 3")
    check(mut t, "choose-span-huge", choice_text("0-99999999999"), "error: out of range 0..2: 3")
    check(mut t, "under-same", "{can.from_under(bstr("/h/a"), "/h/a")}", "true")
    check(mut t, "under-child", "{can.from_under(bstr("/h/a/x"), "/h/a")}", "true")
    check(mut t, "under-prefix", "{can.from_under(bstr("/h/ab"), "/h/a")}", "false")
    check(mut t, "under-root", "{can.from_under(bstr("/x"), "/")}", "true")
    var keys = List[List[byte]]()
    for k in ["b", "a", "b", "a"] {
        (mut keys).push(bstr(k))
    }
    check(mut t, "order-stable", shown_ints(can.order(keys)), "[1,3,0,2]")
    var dated = List[List[byte]]()
    (mut dated).push(can.sort_key("2020-01-01T00:00:00", bstr("/a"), false))
    (mut dated).push(can.sort_key("", bstr("/z"), false))
    (mut dated).push(can.sort_key("2020-01-01T00:00:00", bstr("/0"), false))
    check(mut t, "order-undated-first", shown_ints(can.order(dated)), "[1,2,0]")
    var by_path = List[List[byte]]()
    (mut by_path).push(can.sort_key("2021-01-01T00:00:00", bstr("/z"), true))
    (mut by_path).push(can.sort_key("2022-01-01T00:00:00", bstr("/a"), true))
    check(mut t, "order-by-path", shown_ints(can.order(by_path)), "[1,0]")
}

fn hardening_rows(mut t: Tally) {
    check(mut t, "cut-number", "{can.cut_number("12")}", "12")
    check(mut t, "cut-number-empty", "{can.cut_number("")}", "-1")
    check(mut t, "cut-number-word", "{can.cut_number("1x")}", "-1")
    check(mut t, "cut-number-sign", "{can.cut_number("-3")}", "-1")
    let (n, ms) = can.cut_pause("4:250")
    check(mut t, "cut-pause", "{n} {ms}", "4 250")
    let (n2, ms2) = can.cut_pause("4")
    check(mut t, "cut-pause-no-colon", "{n2} {ms2}", "-1 -1")
    let (n3, ms3) = can.cut_pause(":5")
    check(mut t, "cut-pause-no-step", "{n3} {ms3}", "-1 -1")
    let real = "/h/a.txt"
    let pending = can.bytes_of(can.copying_text())
    check(mut t, "stale-empty", "{can.stale_for(List[byte](), real, false)}", "true")
    check(mut t, "stale-copying", "{can.stale_for(pending, real, false)}", "true")
    check(mut t, "stale-copying-item", "{can.stale_for(pending, real, true)}", "true")
    let own = can.bytes_of("[Trash Info]\nPath=/h/a.txt\nDeletionDate=2020-01-01T00:00:00\n")
    check(mut t, "stale-own-path", "{can.stale_for(own, real, false)}", "true")
    check(mut t, "stale-own-path-item", "{can.stale_for(own, real, true)}", "false")
    let encoded = can.bytes_of("[Trash Info]\nPath=/h/a%20b\n")
    check(mut t, "stale-encoded-path", "{can.stale_for(encoded, "/h/a b", false)}", "true")
    let other = can.bytes_of("[Trash Info]\nPath=/elsewhere/a.txt\n")
    check(mut t, "stale-other-path", "{can.stale_for(other, real, false)}", "false")
    let pathless = can.bytes_of("[Trash Info]\nDeletionDate=2020-01-01T00:00:00\n")
    check(mut t, "stale-pathless", "{can.stale_for(pathless, real, false)}", "false")
    check(mut t, "stale-empty-item", "{can.stale_for(List[byte](), real, true)}", "false")
    let (has_path, _, _) = can.parse_info(pending)
    check(mut t, "copying-has-no-path", "{has_path}", "false")
    check(
        mut t,
        "same-list",
        "{can.same_list(can.bytes_of("ab"), can.bytes_of("ab"))} {can.same_list(can.bytes_of("ab"), can.bytes_of("a"))}",
        "true false",
    )
}

fn main() -> int {
    var t = Tally { failed: 0 }
    text_rows(mut t)
    path_rows(mut t)
    name_rows(mut t)
    date_rows(mut t)
    arg_rows(mut t)
    info_rows(mut t)
    date_shape_rows(mut t)
    civil_rows(mut t)
    glob_rows(mut t)
    int_rows(mut t)
    opts_rows(mut t)
    restore_rows(mut t)
    hardening_rows(mut t)
    if t.failed > 0 then 1 else 0
}

//! census: a recursive walk that never follows a link, by path
//! (`fs_read_dir_entries` and `fs_lstat`) and by held directory
//! (`fs_open_mode` with bits 32 and 16, then the `_at` calls).
//! Arguments: LABEL DIR.

struct Count {
    dirs: int,
    files: int,
    links: int,
    other: int,
}

fn add(mut c: Count, kind: int) {
    if kind == 1 {
        c.dirs += 1
    } else if kind == 0 {
        c.files += 1
    } else if kind == 3 {
        c.links += 1
    } else {
        c.other += 1
    }
}

fn by_path(mut c: Count, dir: str) -> () ! {denied, io, not_found, utf8} {
    for e in fs_read_dir_entries(dir)? {
        let name = str_from_utf8(e[1..])?
        add(mut c, e[0] as int)
        if e[0] as int == 1 { by_path(mut c, "{dir}/{name}")? }
    }
}

fn by_handle(mut c: Count, fd: int) -> () ! {
    denied,
    invalid,
    io,
    not_found,
    unsupported,
    utf8,
    exists,
} {
    for e in fs_read_dir_entries_at(fd)? {
        let name = str_from_utf8(e[1..])?
        let w = fs_lstat_at(fd, name)?
        add(mut c, w[0])
        if w[0] == 1 {
            let sub = fs_open_at(fd, name, 0 + 32 + 16, 0)?
            by_handle(mut c, sub)?
            fs_close(sub) else |_| {}
        }
    }
}

fn main() -> int {
    let a = env_args()
    let (d, l) = ("{a[1]}/tree", a[0])
    fs_create_dir_all("{d}/sub/deeper") else |e| { print("ROW walk@{l} setup:{e}") }
    fs_write_text("{d}/f", "f") else |e| { print("ROW walk@{l} setup:{e}") }
    fs_write_text("{d}/sub/g", "g") else |e| { print("ROW walk@{l} setup:{e}") }
    fs_symlink("sub", "{d}/to-sub") else |e| { print("ROW walk@{l} setup:{e}") }
    var c = Count { dirs: 0, files: 0, links: 0, other: 0 }
    by_path(mut c, d) else |e| { print("ROW walk@{l} {e} errno={os_error()}") }
    print("ROW walk@{l} dirs={c.dirs} files={c.files} links={c.links} other={c.other}")
    var h = Count { dirs: 0, files: 0, links: 0, other: 0 }
    let fd = fs_open_mode(d, 0 + 32 + 16) else |e| {
        print("ROW walk-at@{l} open:{e} errno={os_error()}")
        return 0
    }
    by_handle(mut h, fd) else |e| { print("ROW walk-at@{l} {e} errno={os_error()}") }
    print("ROW walk-at@{l} dirs={h.dirs} files={h.files} links={h.links} other={h.other}")
    0
}
